{
  "identifier": "main-analyzer",
  "description": "The local main window can inspect recordings, open their Loom pages, manage settings, per-download destinations and the download history, read a link list chosen in a native dialog, and save or cancel downloads.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-analyze-url",
    "allow-get-settings",
    "allow-set-options",
    "allow-set-theme",
    "allow-set-retries",
    "allow-set-batch",
    "allow-set-resume",
    "allow-downloaded",
    "allow-open-link-list",
    "allow-choose-folder",
    "allow-ask-each-time",
    "allow-choose-ffmpeg",
    "allow-auto-ffmpeg",
    "allow-app-info",
    "allow-choose-download-folder",
    "allow-pin-download-folder",
    "allow-clear-download-folder",
    "allow-save-recording",
    "allow-cancel-save",
    "allow-open-in-loom"
  ]
}
